# Copy this file to .env before running Compose. Do not commit .env.
# Database name, user, and password are required. These are local examples only.
POSTGRES_DB=hacker_news
POSTGRES_USER=hacker_news
# Single quotes preserve literal $ and # characters in Compose .env values.
POSTGRES_PASSWORD='local_dev_password'
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000
# Seconds to reuse the complete snapshot; 0 disables caching.
CACHE_TTL_SECONDS=60
